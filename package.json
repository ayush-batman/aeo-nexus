{
  "name": "aeo-nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components hooks lib proxy.ts tests",
    "typecheck": "tsc --noEmit",
    "typecheck:mcp": "tsc -p mcp-server/tsconfig.json --noEmit",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "convex:check": "CONVEX_AGENT_MODE=anonymous convex dev --once",
    "test": "npm run test:node && npm run test:convex",
    "test:node": "tsx --test tests/**/*.test.ts",
    "test:convex": "vitest run --config vitest.convex.config.mts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:e2e": "node scripts/e2e/public-journeys.mjs",
    "scan:dylect": "npx tsx scripts/run-dylect-scan.ts",
    "debug:claude": "npx tsx scripts/debug-claude.ts"
  },
